<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>mad-dc</AssemblyName>
    <RootNamespace>MadDC</RootNamespace>
    <Version>1.0.0</Version>
    <Company>mad-dc</Company>
    <Product>mad-dc</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\mad-dc-stub\bin\Release\net8.0-windows\win-x64\publish\mad-dc-stub.exe">
      <LogicalName>mad-dc-stub.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
